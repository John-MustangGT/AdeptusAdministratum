  "abilities": [
    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Fire and Faith",
      "description": "Each time this unit is selected to shoot, you can re-roll one hit roll.",
      "type": "unit",
      "timing": "shooting phase"
    }
  ],
  "keywords": {
    "faction": ["IMPERIUM", "ADEPTA SORORITAS", "ADEPTUS MINISTORUM"],
