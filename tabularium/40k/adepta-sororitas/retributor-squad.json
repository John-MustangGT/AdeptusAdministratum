  "wargear_options": [
    {
      "id": "retributor_superior_storm_bolter",
      "description": "The Retributor Superior can replace her bolt pistol with a storm bolter.",
      "type": "replace",
      "replaces": ["bolt_pistol"],
      "adds": ["storm_bolter"],
      "points_cost": 0,
      "cost_per": "selection",
      "limits": { "max_per_unit": 1 }
    },
    {
      "id": "heavy_weapon_heavy_bolter",
      "description": "Any Retributor can replace her boltgun with a heavy bolter (up to 4 heavy weapons per unit).",
