  "abilities": [
    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Bodyguard",
      "description": "While this unit contains 5 or more models, each time an attack targets a friendly CHARACTER within this unit, the attack is allocated to a Celestian model in the unit instead.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Veteran Warriors",
      "description": "Each time a model in this unit makes an attack, re-roll a Hit roll of 1.",
      "type": "unit",
      "timing": "passive"
    }
  ],
