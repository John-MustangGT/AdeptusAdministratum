    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Simulacrum Imperialis",
      "description": "While this unit contains a model with the SIMULACRUM keyword, each time you use an Act of Faith on this unit, gain D6 Miracle dice instead of D3.",
      "type": "wargear",
      "timing": "passive",
