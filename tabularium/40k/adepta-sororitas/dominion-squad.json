  "abilities": [
    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Scouts 6\"",
      "description": "Before the first battle round begins, this unit can make a Normal Move of up to 6\" (they cannot end this move within Engagement Range of any enemy units).",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Vanguard",
      "description": "Each time this unit makes a ranged attack against a target it can see, re-roll a Hit roll of 1.",
      "type": "unit",
      "timing": "shooting phase"
    }
  ],
