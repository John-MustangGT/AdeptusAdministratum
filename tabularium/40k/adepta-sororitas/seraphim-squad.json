  "abilities": [
    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "FLY",
      "description": "This unit can move over models and terrain features as if they were not there when making a Normal Move, Advance, or charge move.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Swooping Dive",
      "description": "Each time this unit makes a charge move, until the end of the turn, add 1 to the Attacks characteristic of models in this unit.",
      "type": "unit",
      "timing": "charge phase"
    }
  ],
