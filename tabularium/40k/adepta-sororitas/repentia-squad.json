  "abilities": [
    {
      "name": "Acts of Faith",
      "description": "At the start of each phase, if you have not used an Act of Faith this phase, one unit from your army with this ability can use an Act of Faith. If it does, gain D3 Miracle dice.",
      "type": "faction",
      "timing": "any phase"
    },
    {
      "name": "Aegis of the Emperor",
      "description": "This unit has a 6+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Desperate for Redemption",
      "description": "Each time this unit is selected to fight, add 1 to the Attacks characteristic of Sister Repentia models in this unit until the end of the phase.",
      "type": "unit",
      "timing": "fight phase"
    },
    {
      "name": "Sacrosanct Flesh",
      "description": "Each time a Sister Repentia model is destroyed, roll one D6: on a 4+, that model is not removed from play. Instead, that model can fight (if it has not already done so this phase) before being removed.",
      "type": "unit",
      "timing": "fight phase"
    }
  ],
