  "abilities": [
    {
      "name": "Oath of Moment",
      "description": "At the start of your Command Phase, select one enemy unit visible to your WARLORD. Until the start of your next Command Phase, that unit is your Oath of Moment target. Each time a friendly ADEPTUS ASTARTES unit makes an attack against your Oath of Moment target, you can re-roll the Hit roll.",
      "type": "faction",
      "timing": "command phase"
    },
    {
      "name": "Combat Squads",
      "description": "Before the battle, this unit can be split into two units of 5 models each (only if it contains 10 models).",
      "type": "unit",
      "timing": "passive",
      "condition": { "type": "unit_size_gte", "value": 10 }
    }
  ],
