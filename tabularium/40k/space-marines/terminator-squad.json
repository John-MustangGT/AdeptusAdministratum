  "abilities": [
    {
      "name": "Oath of Moment",
      "description": "At the start of your Command Phase, select one enemy unit visible to your WARLORD. Until the start of your next Command Phase, that unit is your Oath of Moment target. Each time a friendly ADEPTUS ASTARTES unit makes an attack against your Oath of Moment target, you can re-roll the Hit roll.",
      "type": "faction",
      "timing": "command phase"
    },
    {
      "name": "Terminator Armour",
      "description": "Models in this unit have a 4+ invulnerable save.",
      "type": "unit",
      "timing": "passive"
    },
    {
      "name": "Deep Strike",
      "description": "During the Reinforcements step of any of your Movement phases, this unit can be set up anywhere on the battlefield that is more than 9\" horizontally away from all enemy models.",
      "type": "unit",
      "timing": "movement phase"
    }
  ],
